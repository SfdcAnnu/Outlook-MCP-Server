# ── Outlook MCP Server ──────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# Public URL where this server is reachable (no trailing slash).
# Local dev: http://localhost:3100   Render: https://your-app.onrender.com
BASE_URL=http://localhost:3100
PORT=3100

# ── Microsoft Entra ID (Azure AD) app registration ──────────────
# Portal: https://entra.microsoft.com → App registrations → New
#   1. Supported account types: "Accounts in any organizational directory
#      and personal Microsoft accounts" (multi-tenant + personal)
#   2. Redirect URIs (Web):
#        https://claude.ai/api/mcp/auth_callback     (Claude connector)
#        <BASE_URL>/auth/callback                    (PATH B standalone)
#   3. API permissions (Microsoft Graph, Delegated):
#        Mail.Read, Mail.ReadWrite, Mail.Send, User.Read, offline_access
#   4. Certificates & secrets → New client secret → copy the VALUE
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Tenant: 'common' = work/school + personal accounts
#         'organizations' = work/school only
#         '<tenant-id>' = a single org
MS_TENANT=common

# Redirect for the PATH B flow (standalone clients: n8n, Cursor, custom apps)
MS_REDIRECT_URI=http://localhost:3100/auth/callback
